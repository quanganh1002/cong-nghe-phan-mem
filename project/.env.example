# Sao chép file này thành .env.local rồi điền giá trị (KHÔNG đưa .env.local lên git).

# Mã PIN vào khu quản trị /admin (mặc định 1234 nếu bỏ trống)
ADMIN_PIN=1234

# Chỉ cần khi deploy lên Vercel: lưu số người online + thống kê truy cập trên Supabase.
# Bỏ trống 2 dòng này thì web lưu trên máy (bộ nhớ + data/visits.json). Tạo bảng bằng supabase/schema.sql.
# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=
# Supabase → Project Settings → API Keys → Secret key (sb_secret_...) hoặc Legacy "service_role"
SUPABASE_SECRET_KEY=
