# Sao chép file này thành .env.local rồi điền giá trị (KHÔNG đưa .env.local lên git).
# Bỏ trống 2 dòng SUPABASE thì web lưu đơn vào file data/orders.json trên máy.

# Supabase → Project Settings → Data API (hoặc nút "Connect") → Project URL
SUPABASE_URL=

# Supabase → Project Settings → API Keys → Secret key (sb_secret_...)
# hoặc tab "Legacy API Keys" → service_role
SUPABASE_SECRET_KEY=

# Mã PIN vào trang bếp /admin và /admin/thong-ke
ADMIN_PIN=1234
