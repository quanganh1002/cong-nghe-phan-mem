<mxfile host="app.diagrams.net"><diagram id="activity-voice" name="Sơ đồ hoạt động: chọn giọng đọc"><mxGraphModel dx="830" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="830" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
